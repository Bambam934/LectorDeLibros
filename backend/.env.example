PORT=3000
HOST=127.0.0.1
NODE_ENV=development

DATABASE_URL=postgresql://user:strong_password_here@localhost:5432/lectorsync
JWT_SECRET=generate_with_node_-_e_console.log_require_crypto_.randomBytes_64_.toString_hex_

# Requerido por docker-compose (postgres + DATABASE_URL interna).
# docker compose up aborta si no esta definido.
POSTGRES_PASSWORD=strong_password_here

# Solo para `npm run db:seed` en desarrollo (el seed se niega en producción).
SEED_DEMO_PASSWORD=

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=15 minute

CORS_ORIGINS=http://localhost:3000,https://tu-dominio.com

HELMET_ENABLED=1

# NVIDIA NIM API (GLM-5.1)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
ELEVENLABS_DEFAULT_VOICE_ID=your-voice-id-here
# Con TTS_PROVIDER=elevenlabs solo se aceptan estas voces (comas) y la de por defecto.
ELEVENLABS_ALLOWED_VOICE_IDS=
# Caracteres sintetizados por usuario y día, y peticiones de audio por minuto.
TTS_DAILY_CHAR_QUOTA=200000
TTS_RATE_LIMIT_MAX=10
